# Copy this file to .env and fill in the values. Never commit .env.
# This file holds variable names and comments only. No real value belongs here.

# Ports
# Port the app listens on (default: 3202)
APP_PORT=
# Port the payment gateway listens on (default: 3203)
GATEWAY_PORT=

# Address of the app used in email links (claim links). Local development: http://localhost:3202
BASE_URL=

# Public address Rapyd sends the payer back to after paying. Rapyd rejects localhost, so this must be public.
# Defaults to BASE_URL when empty.
RETURN_BASE_URL=

# Path to the SQLite database file (default: backend/data/guacapay.db)
DATABASE_PATH=

# Secrets for signing tokens and hashing codes (at least 32 characters each)
JWT_SECRET=
HMAC_SECRET=

# Shared secret between the app and the gateway, in both directions. At least 32 characters.
GATEWAY_TOKEN=

# Rapyd (card rail, development only)
RAPYD_ACCESS_KEY=
RAPYD_SECRET_KEY=
# true = Rapyd sandbox, false = production (default: true)
RAPYD_SANDBOX=
# Two-letter country code of the Rapyd merchant account (default: CO)
RAPYD_COUNTRY=
# Public URL Rapyd calls for webhooks. Must match the URL configured in Rapyd.
RAPYD_WEBHOOK_URL=

# Open Payments (Interledger test network, the only money rail in the product)
OPEN_PAYMENTS_WALLET_ADDRESS=
OPEN_PAYMENTS_KEY_ID=
# Path to the Ed25519 private key file, outside this repository
OPEN_PAYMENTS_PRIVATE_KEY_PATH=
# Optional: a receiver wallet used only by tests and the end-to-end script
OPEN_PAYMENTS_RECEIVER_WALLET_ADDRESS=
# The platform's custody wallet: holds money between the sender's payment and the claim. Its wallets row ID, and its address.
CUSTODY_WALLET_ID=
CUSTODY_WALLET_ADDRESS=
# Hosts the server may call for Open Payments, comma-separated. Anything else is refused before a request is sent.
OPEN_PAYMENTS_HOSTS=
# Key that encrypts consent tokens at rest: 64 hexadecimal characters (32 bytes). Generate it, never reuse another key.
GRANT_ENCRYPTION_KEY=

# Money rail: openpayments (default, test wallets only) or rapyd (card checkout, development only)
PAYMENT_RAILS=

# Claims
# Comma-separated wallet hosts a claim may pay out to (default: ilp.interledger-test.dev, testnet only)
CLAIM_WALLET_HOSTS=

# Payments
# Smallest and largest amount in cents (defaults: 100 and 1000000)
PAYMENT_MIN_CENTS=
PAYMENT_MAX_CENTS=
# Comma-separated list of accepted currencies (default: USD)
PAYMENT_CURRENCIES=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Sender address shown in emails (default: guacapay <no-reply@guacapay.local>)
SMTP_FROM=

# Local development only. The Docker stack sets these itself.
GATEWAY_URL=
APP_URL=
